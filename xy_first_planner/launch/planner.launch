<launch>
    <node pkg="xy_first_planner" type="xy_first_planner_serivce.py" name="xy_first_planner_service" output="screen">
        
        <param name="xy_goal_tolerance" value="0.05" />
        <param name="yaw_goal_tolerance" value="0.05" />

        <param name="max_vel_x" value="0.2" />
        <param name="max_vel_y" value="0.2" />
        <!-- 旋转速度设为 0.6 rad/s (约34度/秒)，如果觉得对齐还是慢，可以改为 1.0 -->
        <param name="max_vel_theta" value="0.6" />
        <param name="min_vel_theta" value="0.3" />


        <param name="kp_x" value="1.0" />
        <param name="ki_x" value="0.00" />
        <param name="kd_x" value="0.4" />
        

        <param name="kp_y" value="1.0" />
        <param name="ki_y" value="0.00" />
        <param name="kd_y" value="0.4" />

        <param name="kp_yaw_cruise" value="0.8" /> 
        <param name="ki_yaw_cruise" value="0.0" /> 
        <param name="kd_yaw_cruise" value="1.0" /> 
        

        <param name="kp_yaw_align" value="3.5" /> 
        <param name="ki_yaw_align" value="0.4" /> 
        <param name="kd_yaw_align" value="0.5" /> 
        

        <param name="integral_limit_x" value="0.2" />
        <param name="integral_limit_y" value="0.2" />
        <param name="integral_limit_yaw" value="1.0" />
        

        <param name="lookahead_distance" value="0.5" />
        <param name="control_rate" value="25.0" />
        
    </node>
</launch> 
