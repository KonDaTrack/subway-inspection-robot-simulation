<launch>
    <!-- 设置地图的配置文件 -->
    <arg name="map" default="map.yaml" />
    <!-- 运行地图服务器，并且加载设置的地图-->
    <node name="map_server" pkg="map_server" type="map_server" args="/home/robot/catkin_ws/src/base_controller/map/map.yaml"/>
    <!-- 启动AMCL节点 -->
    <include file="$(find base_controller)/launch/amcl_omni.launch" />
    <!-- <node pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py" name="keyboard" output = "screen"/> -->
</launch>
