<?xml version="1.0"?>
<robot name="robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find robot_description)/urdf/base_mecanum.urdf.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/panda.urdf.xacro"/>

  <!-- Instantiate the Panda arm connected to panda_base -->
  <xacro:panda_arm/>

  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
      <legacyModeNS>true</legacyModeNS>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin name="wpr_plugin" filename="libwpr_plugin.so">
    <commandTopic>cmd_vel</commandTopic>
    <odometryTopic>odom</odometryTopic>
    <odometryFrame>odom</odometryFrame>
    <robotBaseFrame>base_footprint</robotBaseFrame>
    <odometryRate>20.0</odometryRate>
    <publishOdometryTf>true</publishOdometryTf>
    <yaw_velocity_p_gain>500.0</yaw_velocity_p_gain>
    <x_velocity_p_gain>40000.0</x_velocity_p_gain>
    <y_velocity_p_gain>30000.0</y_velocity_p_gain>
    </plugin>
  </gazebo>

</robot>
